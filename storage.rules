rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Users profile pictures
    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // General profile pictures
    match /profile_pictures/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Campaign images
    match /campaigns/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Banners and media
    match /banners/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Welfare evidence
    match /welfare_evidence/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Default fallback
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
