# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# FIREBASE_SERVICE_ACCOUNT_BASE64: Base64-encoded JSON key for Firebase Admin SDK
FIREBASE_SERVICE_ACCOUNT_BASE64="MY_BASE64_SERVICE_ACCOUNT"

# FIREBASE_SERVICE_ACCOUNT: Plain JSON key for Firebase Admin SDK (Local Dev fallback)
FIREBASE_SERVICE_ACCOUNT="MY_SERVICE_ACCOUNT_JSON"

# RESEND_API_KEY: Required to send recovery emails.
RESEND_API_KEY="MY_RESEND_API_KEY"

# RELWORX_API_KEY: Relworx API key for mobile money processing
RELWORX_API_KEY="MY_RELWORX_API_KEY"

# RELWORX_API_SECRET: Relworx API secret
RELWORX_API_SECRET="MY_RELWORX_API_SECRET"

# RELWORX_MERCHANT_ID: Relworx Merchant ID
RELWORX_MERCHANT_ID="MY_RELWORX_MERCHANT_ID"

# RELWORX_WEBHOOK_SECRET: Secret to verify incoming Relworx webhooks
RELWORX_WEBHOOK_SECRET="MY_RELWORX_WEBHOOK_SECRET"

# DIAGNOSTIC_KEY: Optional secret key for securing the temporary /api/admin/health endpoint
DIAGNOSTIC_KEY="MY_DIAGNOSTIC_KEY"
