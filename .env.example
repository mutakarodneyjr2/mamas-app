# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# FIREBASE_SERVICE_ACCOUNT_BASE64: Base64-encoded JSON key for Firebase Admin SDK
FIREBASE_SERVICE_ACCOUNT_BASE64="MY_BASE64_SERVICE_ACCOUNT"

# RESEND_API_KEY: Required to send recovery emails.
RESEND_API_KEY="MY_RESEND_API_KEY"

# RELWORX_API_KEY: Relworx API key for mobile money processing
RELWORX_API_KEY="MY_RELWORX_API_KEY"

# RELWORX_API_SECRET: Relworx API secret
RELWORX_API_SECRET="MY_RELWORX_API_SECRET"

# RELWORX_MERCHANT_ID: Relworx Merchant ID
RELWORX_MERCHANT_ID="MY_RELWORX_MERCHANT_ID"

# RELWORX_WEBHOOK_KEY / RELWORX_WEBHOOK_SECRET: Key to verify incoming Relworx webhooks (HMAC-SHA256)
RELWORX_WEBHOOK_KEY="MY_RELWORX_WEBHOOK_KEY"
RELWORX_WEBHOOK_SECRET="MY_RELWORX_WEBHOOK_SECRET"

# VITE_FIREBASE_VAPID_KEY: Public Web Push VAPID Key for Firebase Cloud Messaging
VITE_FIREBASE_VAPID_KEY="MY_VAPID_KEY"

# VITE_API_BASE_URL: Backend API base URL for Capacitor native builds and cross-origin environments (no trailing slash).
# Leave empty for standard same-origin web deployments.
VITE_API_BASE_URL=https://YOUR_PRODUCTION_VERCEL_DOMAIN

# VITE_PUBLIC_APP_URL: Public web app continue URL for Firebase Auth email verification & password reset
VITE_PUBLIC_APP_URL=https://YOUR_PRODUCTION_DOMAIN

# VITE_ANDROID_PACKAGE: Android application package ID for Capacitor deep link handling (default: org.mamas.alumni)
VITE_ANDROID_PACKAGE=org.mamas.alumni

# VITE_IOS_BUNDLE_ID: iOS bundle identifier for Capacitor deep link handling (default: org.mamas.alumni)
VITE_IOS_BUNDLE_ID=org.mamas.alumni

# DIAGNOSTIC_KEY: Optional secret key for securing the temporary /api/admin/health endpoint
DIAGNOSTIC_KEY="MY_DIAGNOSTIC_KEY"
