{
  "version": 2,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/api", "destination": "/api" },
    { "source": "/webhook(.*)", "destination": "/api" },
    { "source": "/relworx/(.*)", "destination": "/api" },
    { "source": "/((?!api/|assets/|favicon.ico).*)", "destination": "/index.html" }
  ]
}