rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function userExists() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function getUserRole() {
      return userExists() ? getUserData().get('role', 'member') : 'none';
    }
    
    function isSuperAdmin() {
      return getUserRole() == 'super_admin';
    }

    function isVerifiedMember() {
      return isAuthenticated() && userExists() && getUserData().get('status', 'pending') == 'approved';
    }
    
    function hasRole(allowedRoles) {
      return getUserRole() in allowedRoles;
    }

    function isPayoutAdmin() {
      return hasRole(['super_admin', 'treasurer', 'chairperson']);
    }

    function isApprovalAdmin() {
      return hasRole(['super_admin', 'chairperson', 'vice_chairperson', 'secretary']);
    }

    function notUpdatingRelworxFields() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'paymentStatus', 'gatewayResponse', 'relworxTransactionId', 'relworxReference', 
        'paidAt', 'relworxDisbursementId', 'disbursementStatus'
      ]);
    }

    // =========================================
    // Transactions Collection (Relworx integration)
    // Read: Admins
    // Write: Cloud Functions only (so no client writes)
    // =========================================
    match /transactions/{transactionId} {
      allow read: if hasRole(['super_admin', 'treasurer', 'chairperson', 'secretary', 'auditor']);
      allow write: if false; 
    }

    // =========================================
    // 1. Users Collection
    // Read: Owner or authorized committee/admin roles only (protecting PII from raw member scraping)
    // Create: Users on registration
    // Update: Owner (with restrictions) or Admins
    // Delete: Strictly disabled (CRIT-04)
    // =========================================
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || hasRole(['super_admin', 'chairperson', 'vice_chairperson', 'secretary', 'treasurer', 'auditor', 'mobiliser']));
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if (isAuthenticated() && request.auth.uid == userId && (
                        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status'])
                        || (request.resource.data.status == 'pending_deletion' && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']))
                      ))
                    || isSuperAdmin() 
                    || (isApprovalAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'rejectionReason', 'rejectedAt', 'rejectedBy', 'updatedAt']));
      allow delete: if false;
    }

    // =========================================
    // 1b. Directory Profiles Collection (Safe Projection for CRIT-01)
    // Read: Verified members & committee
    // Write: Owner or Admins
    // =========================================
    match /directoryProfiles/{userId} {
      allow read: if isVerifiedMember() || hasRole(['super_admin', 'chairperson', 'vice_chairperson', 'secretary', 'treasurer', 'auditor', 'mobiliser']);
      allow create, update: if isAuthenticated() && (request.auth.uid == userId || hasRole(['super_admin', 'chairperson']));
      allow delete: if isAuthenticated() && (request.auth.uid == userId || isSuperAdmin());
    }

    // =========================================
    // 2. Contributions Collection
    // Read: Authenticated members can view contribution records
    // Create:
    //  - School campaigns: Any authenticated user (including unverified members)
    //  - Welfare & Solidarity Support: Verified members only
    //  - Client cannot write verified payment status directly
    // Update: Super Admin, Chairperson, Treasurer can verify/update status
    // Delete: Strictly disabled (financial audit trail integrity)
    // =========================================
    match /contributions/{contributionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid && (
        (request.resource.data.get('type', '') in ['school_support', 'campaign'] || request.resource.data.get('purpose', '') == 'campaign') ||
        isVerifiedMember()
      ) && (
        request.resource.data.get('status', 'pending') in ['pending', 'pending_payment']
      ) && (
        request.resource.data.get('paymentStatus', 'pending') in ['pending', 'pending_payment', 'initiated']
      );
      allow update: if isPayoutAdmin() && (
        !(request.resource.data.diff(resource.data).affectedKeys().hasAny(['amount', 'paymentStatus', 'status'])) || 
        (resource.data.status != 'verified' && resource.data.status != 'success')
      );
      allow delete: if false;
    }

    // =========================================
    // 3. Welfare Requests Collection (Private Case Data - CRIT-02)
    // Read: Applicant OR authorized committee/admin roles only (evidence & phone numbers protected)
    // Create: Verified members only
    // Update: Executive Committee / Applicant
    // Delete: Strictly disabled
    // =========================================
    match /welfareRequests/{requestId} {
      allow read: if isAuthenticated() && ((resource.data.userId == request.auth.uid) || hasRole(['super_admin', 'chairperson', 'vice_chairperson', 'secretary', 'treasurer', 'auditor']));
      allow create: if isVerifiedMember() && request.resource.data.userId == request.auth.uid && request.resource.data.recipientPhoneNumber is string;
      allow update: if (
        // Authorized admins updating another member's welfare case (strict conflict-of-interest enforcement)
        (request.auth.uid != resource.data.userId && (
          isPayoutAdmin() ||
          (hasRole(['vice_chairperson', 'secretary', 'auditor']) && notUpdatingRelworxFields())
        )) ||
        // Applicant editing basic details while pending (cannot touch votes, status, approval, or financial fields)
        (isAuthenticated() && resource.data.userId == request.auth.uid && resource.data.status == 'pending' && notUpdatingRelworxFields() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isPublishedToFeed', 'supportRaisedAmount', 'supportStatus', 'votes', 'status', 'paidAt', 'disbursementStatus', 'paidAmount', 'rejectionReason', 'approvedAt', 'finalizedAt']))
      );
      allow delete: if false;
    }

    // =========================================
    // 3b. Published Welfare Feed Collection (Public-Safe Feed - CRIT-02)
    // Read: Verified members & committee
    // Write: Executive Committee admins only
    // =========================================
    match /publishedWelfareFeed/{feedId} {
      allow read: if isVerifiedMember() || hasRole(['super_admin', 'chairperson', 'vice_chairperson', 'secretary', 'treasurer', 'auditor', 'mobiliser']);
      allow write: if hasRole(['super_admin', 'chairperson', 'vice_chairperson', 'secretary', 'treasurer']);
      allow delete: if hasRole(['super_admin', 'chairperson', 'vice_chairperson', 'secretary', 'treasurer']);
    }

    // =========================================
    // Expenses Collection
    // =========================================
    match /expenses/{expenseId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && hasRole(['super_admin', 'chairperson', 'vice_chairperson', 'treasurer', 'secretary']) && request.resource.data.userId == request.auth.uid && request.resource.data.recipientPhoneNumber is string;
      allow update: if (
        // Authorized admins updating another member's expense claim (strict conflict-of-interest enforcement)
        (request.auth.uid != resource.data.userId && (
          isPayoutAdmin() ||
          (hasRole(['vice_chairperson', 'secretary', 'auditor']) && notUpdatingRelworxFields())
        )) ||
        // Applicant editing basic details while pending (cannot touch votes, status, approval, or financial fields)
        (isAuthenticated() && resource.data.userId == request.auth.uid && resource.data.status == 'pending' && notUpdatingRelworxFields() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'approvalStatus', 'votes', 'paidAt', 'disbursementStatus', 'paidAmount', 'rejectionReason', 'finalDecisionBy']))
      );
      allow delete: if false;
    }

    // =========================================
    // Money Out Collection
    // =========================================
    match /moneyOut/{recordId} {
      allow read: if isAuthenticated();
      allow create, update: if hasRole(['super_admin', 'chairperson', 'vice_chairperson', 'treasurer', 'secretary']);
      allow delete: if false;
    }

    // =========================================
    // 4. School Campaigns Collection
    // Read: Public read for everyone (visitors & unverified members can view campaigns)
    // Write: Super Admin and Chairperson can create/edit campaigns
    // =========================================
    match /schoolCampaigns/{campaignId} {
      allow read: if true;
      allow write: if hasRole(['super_admin', 'chairperson']);
    }

    // =========================================
    // 5. Notices Collection
    // Read: Public read for announcements on all pages
    // Write: Super Admin, Chairperson, Secretary
    // =========================================
    match /notices/{noticeId} {
      allow read: if true;
      allow write: if hasRole(['super_admin', 'chairperson', 'secretary']);
    }

    // =========================================
    // 6. Activity Logs Collection
    // Read: Super Admin, Chairperson, Auditor
    // Create: System logs created on user actions
    // Delete/Update: Immutable append-only audit trail
    // =========================================
    match /activityLogs/{logId} {
      allow read: if hasRole(['super_admin', 'chairperson', 'auditor']);
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // =========================================
    // 7. App Settings Collection
    // Read: All users (even unauthenticated for login support contacts & banners)
    // Write: Super Admin, Chairperson, Vice Chairperson, Treasurer
    // =========================================
    match /appSettings/{document=**} {
      allow read: if true;
      allow write: if hasRole(['super_admin', 'chairperson', 'vice_chairperson', 'treasurer']);
    }
    // =========================================
    // 8. Banners Collections
    // Read: All users (even unauthenticated, for public & ad banners)
    // Write: STRICTLY Super Admin only
    // =========================================
    match /banners/{document=**} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }
    match /landingBanners/{document=**} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // =========================================
    // 9. Notifications Collection
    // Read: User can read notifications targeted to them or broadcast ("ALL_APPROVED")
    // Create: Authenticated users/admins can create notification logs
    // Update: Authenticated users can update notification status (mark as read)
    // =========================================
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || resource.data.userId == 'ALL_APPROVED');
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid || resource.data.userId == 'ALL_APPROVED');
      allow delete: if isSuperAdmin();
    }

    // =========================================
    // 10. Help Articles Collection
    // Read: Public (published articles viewable by all)
    // Write: Admins / Executives
    // =========================================
    match /helpArticles/{articleId} {
      allow read: if true;
      allow write: if hasRole(['super_admin', 'chairperson', 'vice_chairperson', 'secretary']);
    }

    // =========================================
    // 12. Support Tickets Collection
    // Create: Anyone (members or applicants needing help)
    // Read/Update: Super Admin, Chairperson, Secretary, Vice Chairperson
    // =========================================
    match /supportTickets/{ticketId} {
      allow create: if true;
      allow read, update, delete: if hasRole(['super_admin', 'chairperson', 'vice_chairperson', 'secretary']);
    }
  }
}

